# SerendibSuite Environment Variables
# Copy this file to .env and adjust as needed.

# 1. Option A: SQLite (Default, Zero-Setup, works without MySQL or XAMPP)
# DATABASE_URL=sqlite:///../storage/serendibsuite.db

# 2. Option B: MySQL / MariaDB (XAMPP default)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/serendibsuite
